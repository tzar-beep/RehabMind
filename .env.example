# Local development only. Copy to `.env` (git-ignored) and change the values.
# Never put production credentials in any file in this repository.

APP_ENV=development

# ---- PostgreSQL (compose.yaml) ----
# Superuser: container administration only. The application never uses it.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Owns the schema; used by Alembic migrations.
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
# Runtime role: DML only, cannot alter schema or disable triggers.
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=rehabmind

# ---- Redis (sessions, job queue) ----
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://127.0.0.1:6379/0

# ---- S3-compatible object storage (MinIO locally) ----
MINIO_ROOT_USER=dev-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_AUDIO=ephemeral-audio

# ---- Development seed accounts (APP_ENV=development only) ----
# patient@recovery.local, clinician@recovery.local, admin@recovery.local
SEED_DEV_PASSWORD=change-me-seed

# ---- Ephemeral audio (AES-256-GCM, base64 32-byte key) ----
# Production: supplied by a managed KMS/secrets manager, never a file.
AUDIO_ENCRYPTION_KEY=change-me-generate-32-bytes-base64

# ---- Speech-to-text (faster-whisper) ----
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- AI personalization ($0: offline deterministic fake provider) ----
AI_PROVIDER=fake
AI_FAKE_FAULT_RATE=0.2
